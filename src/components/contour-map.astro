---
import { contourLines, MAP_HEIGHT, MAP_WIDTH, peak } from "../land/land.ts";
import { LOGO_RATIO, LOGO_WIDTH, logoHull, MARK_WIDTH } from "../logo.ts";

const clearingWidth = MARK_WIDTH * 1.4;
const clearingHeight = clearingWidth * LOGO_RATIO;
const clearingTransform = `translate(${(peak.x - clearingWidth / 2).toFixed(1)} ${(peak.y - clearingHeight / 2).toFixed(1)}) scale(${(clearingWidth / LOGO_WIDTH).toFixed(4)})`;
---

<svg
  class="contours"
  xmlns="http://www.w3.org/2000/svg"
  width={MAP_WIDTH}
  height={MAP_HEIGHT}
  viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
  style={`--summit-x:${peak.x}px;--summit-y:${peak.y}px`}
  aria-hidden="true"
  focusable="false"
>
  {contourLines.map((line) => <path class={line.isIndex ? "ix" : "ln"} d={line.d} />)}
  <path class="clear" transform={clearingTransform} d={logoHull} />
</svg>
