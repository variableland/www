---
import geistMono from "@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url";
import newsreaderItalic from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-italic.woff2?url";
import newsreader from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";
import { top } from "@variableland/brand/assets/land/land.mjs";
import map from "@variableland/brand/assets/land/map.svg?raw";
import tokens from "@variableland/brand/tokens.json";
import { content, description } from "../content.ts";
import { LOGO_RATIO, logoSvg } from "../logo.ts";
import { OG_HEIGHT, OG_WIDTH } from "../og/og-image.ts";
import "../styles/site.css";

if (Astro.site === undefined) {
  throw new Error("astro.config.mjs sets site: the canonical URL, og:url and og:image are absolute.");
}
const url = new URL("/", Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{content.name}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="canonical" href={url}>
    <meta name="theme-color" content={tokens.color.paper.light} media="(prefers-color-scheme: light)">
    <meta name="theme-color" content={tokens.color.paper.dark} media="(prefers-color-scheme: dark)">
    <meta property="og:site_name" content={content.name}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={url}>
    <meta property="og:title" content={content.name}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content={String(OG_WIDTH)}>
    <meta property="og:image:height" content={String(OG_HEIGHT)}>
    <meta property="og:image:alt" content={content.ogImageAlt}>
    <meta name="twitter:card" content="summary_large_image">
    {[newsreader, newsreaderItalic, geistMono].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body>
    <main class="sheet" style={`--summit-x:${top.x}px;--summit-y:${top.y}px`}>
      <div class="place" style={`--logo-ratio:${LOGO_RATIO}`}>
        <Fragment set:html={logoSvg({ class: "logo", "aria-hidden": "true" })} />
        <h1 class="place-name">{content.name}</h1>
      </div>
      <section class="legend" aria-label={content.legendLabel}>
        <p class="statement"><span>{content.statement.first}</span> <em>{content.statement.second}</em></p>
        <div class="lab">
          <span class="label">{content.lab.role}</span>
          <a href={content.lab.href}>
            <span class="lab-name">{content.lab.name}</span>
            <span class="host-row">
              <span class="label">{content.lab.host}</span>
              <svg class="ext" aria-hidden="true" viewBox="0 0 12 12" width="12" height="12">
                <path d="M3.5 2.5h6v6M9.5 2.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </span>
          </a>
        </div>
      </section>
      <Fragment set:html={map} />
    </main>
  </body>
</html>
