---
import geistMono from "@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url";
import newsreaderItalic from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-italic.woff2?url";
import newsreader from "@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url";
import ContourMap from "../components/contour-map.astro";
import { content, description } from "../content.ts";
import { LOGO_HEIGHT, LOGO_WIDTH, logoShapes } from "../logo.ts";
import "../styles/site.css";

const mark = 64;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{content.name}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <meta name="theme-color" content="#eff0e9" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0f1512" media="(prefers-color-scheme: dark)">
    {[newsreader, newsreaderItalic, geistMono].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body>
    <main class="sheet">
      <div class="map">
        <div class="land" aria-hidden="true"><ContourMap /></div>
        <div class="place" style={`--logo-ratio:${LOGO_HEIGHT / LOGO_WIDTH}`}>
          <svg
            class="logo"
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"
            viewBox={`0 0 ${LOGO_WIDTH} ${LOGO_HEIGHT}`}
            width={mark}
            height={+((mark * LOGO_HEIGHT) / LOGO_WIDTH).toFixed(2)}
            set:html={logoShapes}
          />
          <h1 class="place-name">{content.name}</h1>
        </div>
      </div>
      <section class="legend" aria-label="About">
        <p class="statement"><span>{content.line[0]}</span> <em>{content.line[1]}</em></p>
        <div class="lab">
          <span class="lab-role mono">{content.lab.role}</span>
          <a href={content.lab.href}>
            <span class="lab-name">{content.lab.name}</span>
            <span class="host-row">
              <span class="host mono">{content.lab.host}</span>
              <svg class="ext" aria-hidden="true" focusable="false" viewBox="0 0 12 12" width="12" height="12">
                <path d="M3.5 2.5h6v6M9.5 2.5l-7 7" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </span>
          </a>
        </div>
      </section>
    </main>
  </body>
</html>
